# Copy to .env (gitignored) and fill in. No passwords or cookies are needed:
# this tool only uses Fantrax's published, keyless fxea API.

# From the Fantrax URL: fantrax.com/fantasy/league/<LEAGUE_ID>/...
FANTRAX_LEAGUE_ID=

# Your fantasy team, matched case-insensitively against team name or short name.
MY_TEAM_NAME=The Blue Blazers
# Optional: the short/abbreviated team name Fantrax shows in CSV "Status" columns.
MY_TEAM_SHORT=

# Optional: where the SQLite cache/database lives (default: ./var/hockey.db).
# HOCKEY_DB=./var/hockey.db

# Optional AI layer (`hockey ask`, `hockey news`, `--ai` flags). Install with `uv sync --extra ai`.
# Get a key at https://console.anthropic.com/. Keep it here only: .env is gitignored.
# ANTHROPIC_API_KEY=
